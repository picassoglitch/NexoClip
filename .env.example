# Copy this file to .env and fill in your values.
# .env is gitignored.

# --- LLM provider (Anthropic only) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# --- Optional: which model tier the router picks by default ---
# (config/llm.yaml is the source of truth; these env vars override only at top level)
NEXOCLIP_LLM_DEFAULT_PROVIDER=anthropic
NEXOCLIP_LLM_DEFAULT_QUALITY=standard

# --- Whisper ---
# 'cuda' if you have an NVIDIA GPU; 'cpu' otherwise (much slower).
NEXOCLIP_WHISPER_DEVICE=cuda
# Model size — speed/accuracy tradeoff (per minute of audio, on a modern GPU):
#   tiny   ~5x faster than medium, noticeably lower accuracy
#   base   ~3x faster than medium, OK for English-heavy content
#   small  ~1.5x faster than medium, good general-purpose
#   medium baseline; recommended for production Spanish + English mixed
#   large  ~0.5x; best accuracy, expensive
# When iterating on a long VOD locally, drop to `base` first to verify the
# pipeline end-to-end, then switch back to `medium` for the real run.
NEXOCLIP_WHISPER_MODEL=medium
# 'float16' on GPU; switch to 'int8' for CPU runs.
NEXOCLIP_WHISPER_COMPUTE_TYPE=float16

# --- Output ---
NEXOCLIP_DEFAULT_OUTPUT_DIR=./out

# --- Publishing (Zernio — multi-platform publish layer) ---
# Single company-wide API key from zernio.com (a 67-char `sk_...` secret).
# MUST be the NEXOCLIP_-prefixed name — the bare ZERNIO_API_KEY (what
# Zernio's own SDKs read) is silently ignored by the app. Every
# /dashboard/publish/zernio route returns 503 until this is set.
NEXOCLIP_ZERNIO_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Override only for staging/tests.
# NEXOCLIP_ZERNIO_BASE_URL=https://zernio.com/api/v1
# Shared secret to verify inbound Zernio webhooks (POST /api/webhooks/zernio).
# When unset, the webhook receiver returns 503.
# NEXOCLIP_ZERNIO_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxxxxx

# --- Database (Phase 1+) ---
# SQLite file path; Phase 3 swaps in Aurora.
NEXOCLIP_DB_PATH=./nexoclip.db

# --- Logging ---
NEXOCLIP_LOG_LEVEL=INFO
NEXOCLIP_LOG_FORMAT=console            # console | json

# --- Tenancy (Phase 0 hardcodes this; Phase 1+ replaces with real auth) ---
NEXOCLIP_DEFAULT_TENANT_ID=default

# --- yt-dlp cookie auth (REQUIRED for Kick) ---
# Kick blocks anonymous yt-dlp scraping with HTTP 403 / Cloudflare. Set ONE
# of the two options below. NEXOCLIP_COOKIES_FILE wins when both are set.
#
# Option A (simpler, but the source browser must NOT be running while
# ingesting — Chrome holds an exclusive lock on its cookies DB on Windows,
# yt-dlp #7271. Edge and Firefox don't have this restriction.):
#     chrome | edge | firefox | brave | chromium
# NEXOCLIP_COOKIES_FROM_BROWSER=edge
#
# Option B (most reliable on Windows; browser can stay open):
# Absolute path to a Netscape-format cookies.txt file. Export it once
# with the "Get cookies.txt LOCALLY" browser extension after visiting
# kick.com while signed in. yt-dlp reads the file directly so the browser
# stays open during ingestion.
# NEXOCLIP_COOKIES_FILE=C:/Users/you/projects/QuantorClipAI/.kick_cookies.txt
